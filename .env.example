# Copy to .env and fill in the blanks. Every value below equals the code default unless noted.
# Docker Compose overrides the paths and DATABASE_URL for the containers.
# All model work runs on hosted APIs: Jina (embeddings), Cohere (rerank), Groq (answers).

# ── Observability — Langfuse (optional; leave keys empty to disable tracing) ──
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# ── Embeddings — Jina API (required) ──
# Free key, no card: https://jina.ai/embeddings/. Changing the model rebuilds the whole vector store once.
JINA_API_KEY=
# EMBEDDING_MODEL=jina-embeddings-v3

# ── Reranker — Cohere API (required) ──
# Free trial key, no card: https://dashboard.cohere.com/api-keys
# Trial limits: ~1,000 calls/month across all endpoints and 10 rerank calls/minute; 1 call per question.
COHERE_API_KEY=
# RERANKER_MODEL=rerank-v3.5
# false = skip reranking (lower answer quality). Local runs only: Docker Compose always sets true.
RERANKER_ENABLED=true
# Relevance floor on Cohere's 0–1 scores; below it the bot refuses instead of guessing.
# Tune with eval/retrieval_eval.py.
RERANK_MIN_SCORE=0.0

# ── Knowledge base ──
# true = wipe and re-embed everything on startup. Not needed for new/changed files in data/: those are picked up
# automatically. Local runs only: Docker Compose sets this itself (see docker-compose.yml).
FORCE_REBUILD_VECTORSTORE=false
# Lender names users may mention; questions naming one are answered only from that lender's documents.
KNOWN_LENDER_NAMES=HDFC
# Optional path overrides (defaults are relative to the project root).
# DATA_DIR=./data
# VECTORSTORE_PATH=./vectorstore
# AUDIT_LOG_PATH=./logs/audit.jsonl

# ── LLM — Groq. Free key at https://console.groq.com/keys ──
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Small, fast model that rewrites follow-ups into standalone questions and picks the tool (policy / my application / EMI).
# Groq rate limits are per model, so routing does not eat the answer model's tokens-per-minute.
ROUTER_MODEL=qwen/qwen3.8-27b
# Per-borrower daily token budget. 0 or empty = unlimited (officers/admins are always unlimited).
GROQ_DAILY_BUDGET_TOKENS=50000
MAX_HISTORY_MESSAGES=12
MAX_MESSAGE_CHARS=2000

# ── Database ──
# Local runs. Docker Compose builds its own URL from the three POSTGRES_* values below.
DATABASE_URL=postgresql+asyncpg://loanbot:loanbot@localhost:5432/loanbot
POSTGRES_USER=loanbot
POSTGRES_PASSWORD=loanbot
POSTGRES_DB=loanbot

# ── Auth — JWT_SECRET_KEY is REQUIRED: the app refuses to start without a random secret of at least 32 bytes ──
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=5
REFRESH_TOKEN_EXPIRE_HOURS=1
# Server-side session limits: idle time (backstop for the 5-minute browser idle timer) and absolute length.
SESSION_IDLE_MINUTES=15
SESSION_MAX_HOURS=12
# Encrypts 2FA (TOTP) secrets in the database. You make it up: any long random string, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Empty = a key derived from JWT_SECRET_KEY, so changing the JWT secret would break every enrolled authenticator.
# Set it BEFORE anyone enrolls 2FA and never change it: changing it later makes existing 2FA codes fail (re-enroll needed).
DATA_ENCRYPTION_KEY=

# ── Brute-force protection ──
MAX_FAILED_LOGINS=5
MAX_FAILED_OTP=5
# First lockout length; each repeat lockout doubles it (15, 30, 60 … min, max 24 h) until a successful sign-in.
LOCKOUT_MINUTES=15
# Failed logins one client IP may make per LOCKOUT_MINUTES window, across all accounts, before it gets 429.
IP_FAILED_LOGIN_LIMIT=20
# Peers allowed to set X-Forwarded-For (Streamlit container / local proxy), comma-separated CIDRs.
TRUSTED_PROXIES=127.0.0.1/32,::1/128,172.16.0.0/12

# ── Officer workflow ──
# Claims untouched for this many hours return to the shared queue.
CLAIM_TIMEOUT_HOURS=1

# ── File uploads ──
UPLOAD_DIR=./uploads

# ── Email verification — Gmail SMTP. Leave SMTP_USER / SMTP_PASSWORD empty to disable email ──
# Step 1: Enable 2-Step Verification on your Google account
# Step 2: Create an App Password at https://myaccount.google.com/apppasswords
# Step 3: Paste the 16-character App Password (no spaces) into SMTP_PASSWORD
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Dev only: with SMTP disabled, set true to let new users verify their email instantly from the UI.
DEV_EMAIL_VERIFY=false

# ── Frontend (local runs; Docker Compose sets http://backend:8000) ──
API_URL=http://localhost:8000
