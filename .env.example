LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL="https://cloud.langfuse.com"

CHAT_MODEL=qwen3.5:2b
EMBEDDING_MODEL=nomic-embed-text:latest
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_WARMUP_TIMEOUT=20

# Fallback is optional. Use "none", "groq", or "huggingface".
FALLBACK_MODEL_PROVIDER= none

# Groq fallback. Put the real key only in .env, never in Git.
GROQ_API_KEY= 
GROQ_MODEL=openai/gpt-oss-20b

# Hugging Face fallback. Put the real key only in .env, never in Git.
HF_API_KEY= 
HF_MODEL=Qwen/Qwen3.8-27B

MAX_HISTORY_MESSAGES=12
MAX_MESSAGE_CHARS=2000
