LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL="https://cloud.langfuse.com"

CHAT_MODEL=qwen3.5:2b
EMBEDDING_MODEL=nomic-embed-text:latest
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_WARMUP_TIMEOUT=20
DATA_DIR=./data
VECTORSTORE_PATH=./vectorstore

# Optional: set this only when you want to ingest one specific PDF instead of every PDF in DATA_DIR.
# PDF_PATH=./data/example.pdf

# Set to "true" to force a full re-ingest and re-embed on next startup (then remove it).
# In Docker: add this to the environment block or pass -e FORCE_REBUILD_VECTORSTORE=true.
# Locally with a terminal: you will be prompted interactively instead.
# FORCE_REBUILD_VECTORSTORE=false

# Fallback is optional. Use "none", "groq", or "huggingface".
FALLBACK_MODEL_PROVIDER=none

# Groq fallback. Put the real key only in .env, never in Git.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Hugging Face fallback. Put the real key only in .env, never in Git.
HF_API_KEY=
HF_MODEL=mistralai/Mistral-7B-Instruct-v0.3

MAX_HISTORY_MESSAGES=12
MAX_MESSAGE_CHARS=2000
