FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

COPY requirements-frontend.txt constraints.txt ./

RUN pip install --no-cache-dir --default-timeout=300 --retries=10 -r requirements-frontend.txt -c constraints.txt

COPY frontend ./frontend
# Streamlit reads .streamlit/config.toml from the working directory
COPY .streamlit ./.streamlit

RUN adduser --disabled-password --gecos "" appuser && chown -R appuser /app
USER appuser

EXPOSE 8501

CMD ["streamlit", "run", "frontend/streamlit_app.py", "--server.address=0.0.0.0", "--server.port=8501", "--server.headless=true"]
